{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winvm.bridge/schemas/capability.schema.json",
  "title": "CapabilityDefinition",
  "description": "WinVM Bridge 统一能力定义契约（CAPABILITY-MODEL.md §4）",
  "type": "object",
  "required": [
    "id",
    "domain",
    "name",
    "description",
    "risk",
    "idempotent",
    "requiresSession",
    "destructive",
    "timeoutMs",
    "input",
    "output",
    "audit",
    "implementation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(system|app|storage|gui|meta)\\.[a-z0-9]+\\.[a-z0-9]+$",
      "description": "能力 ID，形如 system.service.control"
    },
    "domain": { "enum": ["system", "app", "storage", "gui", "meta"] },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["L0", "L1", "L2", "L3"] },
    "idempotent": { "type": "boolean" },
    "requiresSession": {
      "type": "boolean",
      "description": "是否依赖 Windows 交互式会话。GUI 能力必须为 true。"
    },
    "requiresApproval": {
      "type": "boolean",
      "description": "是否强制审批。未指定时由 risk 推导（L2/L3 → true）。"
    },
    "supportsDryRun": {
      "type": "boolean",
      "description": "U-P0-3（A1 服务端能力声明制）：本能力的 dryRun 是否由服务端实现真实支持（只返回执行计划、零系统变更）。仅显式 true 的能力在传 dryRun:true 时享受免审批旁路；未声明回落审批闸（fail-closed）。"
    },
    "destructive": { "type": "boolean" },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
    "input": { "type": "object", "description": "JSON Schema" },
    "output": { "type": "object", "description": "JSON Schema" },
    "policy": {
      "type": "object",
      "description": "能力级策略覆盖。命令面**只有**黑名单（ARCH-18 裁断：commandAllowlist 为死配置，已从契约与本 schema 删除；解释器准入由注册表枚举 + 登记期校验把守）。本对象 additionalProperties=false ⇒ 再写 commandAllowlist 会被 schema 直接拒绝（R9 要求核实的严格性已确认成立）。",
      "additionalProperties": false,
      "properties": {
        "commandDenylist": { "type": "array", "items": { "type": "string" } },
        "pathAllowlist": { "type": "array", "items": { "type": "string" } },
        "pathDenylist": { "type": "array", "items": { "type": "string" } },
        "processDenylist": { "type": "array", "items": { "type": "string" } },
        "registryWriteAllowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audit": {
      "type": "object",
      "required": ["snapshot"],
      "additionalProperties": false,
      "properties": {
        "snapshot": { "enum": ["none", "after", "before-after"] }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["kind", "module", "function"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["powershell", "native", "external"] },
        "module": { "type": "string" },
        "function": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "risk": { "enum": ["L2", "L3"] } },
        "required": ["risk"]
      },
      "then": {
        "properties": {
          "audit": {
            "properties": { "snapshot": { "not": { "const": "none" } } },
            "description": "L2/L3 能力必须留存快照，不得为 none"
          }
        }
      }
    }
  ]
}
