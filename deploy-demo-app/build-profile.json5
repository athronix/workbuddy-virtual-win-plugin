{
  "app": {
    // 签名配置留空：正式签名由 DevEco「自动签名」或 CI 注入，仓库不内置 SDK 绝对路径/密钥（保持可移植、无密钥外泄）
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS"
      }
    ]
  },
  "modules": [
    {
      "name": "phone",
      "srcPath": "./product/phone",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "winvm_onetap",
      "srcPath": "./feature/winvm-onetap",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
