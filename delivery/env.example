# ============================================================================
# WinVM Bridge 一键部署配置模板（鸿蒙宿主 + Windows VM 场景）
# ----------------------------------------------------------------------------
# 用法：复制本文件为项目根 .env 后按注释填写（bootstrap.mjs env 子命令可代生成）：
#       cp delivery/env.example .env
#       node delivery/bootstrap.mjs env        # 交互式生成/更新 .env
#
# 读取方：delivery/setup.mjs（7 相位部署编排：BUILD→HOST→VM→VM-START→TUNNEL→TEST→HEALTH）
# 安全：.env 含连接信息，请勿提交入库（.gitignore 已覆盖根目录 .env）。
# 事实依据：本模板键位与 delivery/setup.mjs resolveConfig() 一一对应，
#           推荐值参考 docs/oh-host-install-run-test.md §2「准备配置」。
# ============================================================================

# ---------- 通用 ----------
# VM 内 vm-service 监听端口（仅绑 127.0.0.1 回环，VM 零对外暴露；访问一律经 SSH 隧道）
# 出处：docs/oh-host-install-run-test.md §0「服务 | 仅监听 127.0.0.1:18443」
WINVM_SERVICE_PORT=18443

# ---------- 宿主机侧（install-host.mjs 读取）----------
# 是否部署宿主机侧 WorkBuddy 插件（1=部署，0=跳过）
HOST_DEPLOY=1
# WorkBuddy 主目录（留空 = 自动探测 ~/.workbuddy；鸿蒙宿主即 ~/.workbuddy）
HOST_WORKBUDDY_HOME=
# 部署归属用户名（仅用于日志/路径提示，不参与认证）
HOST_INSTALL_USER=vmadmin

# ---------- VM 侧（install-vm.mjs 读取；scp/ssh 由 setup.mjs 执行）----------
# 是否部署 VM 侧（1=部署，0=跳过）
VM_DEPLOY=1
# VM 地址。【必改】172.16.100.2 仅为本文档作者真机的示例值，
# 你的 VM IP 以虚拟机软件里看到的为准（出处：docs/oh-host-install-run-test.md §0）。
VM_HOST=172.16.100.2
# VM 侧 OpenSSH Server 监听端口（Windows「设置→可选功能」安装的 OpenSSH 默认 22）
VM_SSH_PORT=22
# VM 侧登录用户（Windows 账户名；认证走 SSH 公钥，.env 无密码字段）
VM_USER=User
# VM 内部部署根目录（产物/skills/软链均落在此；正斜杠写法）
VM_DEPLOY_DIR=C:/WinVMBridge

# ---------- VM 内 AI Agent（WINVM_VM_PROVIDER，三选一）----------
#   workbuddy-deterministic : 确定性执行器（默认；运行时不 spawn 任何 CLI，
#                             codebuddy 缺失仅 WARNING 不阻断 —— 出处 delivery/preflight.mjs）
#   workbuddy               : LLM 执行器，VM 内 spawn codebuddy CLI（须安装并登录）
#   hermes-agent            : Nous Hermes 执行器，VM 内 spawn hermes CLI
#                             （CLI 无 --mcp，MCP 须预注册进 config.yaml.mcp_servers）
# 出处：.workbuddy/memory/MEMORY.md「VM 内 AI Agent（WINVM_VM_PROVIDER）」
WINVM_VM_PROVIDER=workbuddy-deterministic
# 策略闸执法灰度（Phase 5 批14）：'' / shadow = 不注入（服务缺省 shadow：观测不执法）；
# on = 跨部署持久执法（allowedCapabilities/maxRisk 真拦）；off = 双闸评估整体关闭。
# 值经 deploy-vm 透传 install-vm --policy-gate-wiring，写入 start-hidden.ps1 赋值区。
# 语义与切换评估见 docs/05-peripherals/DEPLOYMENT.md §1.8。
WINVM_POLICY_GATE_WIRING=
# WorkBuddy CLI 可执行名（仅 provider=workbuddy 时真正生效）
WINVM_WORKBUDDY_CLI=codebuddy
# Hermes CLI 可执行名（仅 provider=hermes-agent 时生效）
WINVM_HERMES_CLI=hermes

# ---------- SSH 隧道（宿主 ↔ VM，仅经 127.0.0.1）----------
# 是否在部署后建立 SSH 本地端口转发（1=是）
WINVM_SETUP_TUNNEL=1
# 宿主侧本地监听端口（/health、MCP、A2A 均走它）
WINVM_TUNNEL_LOCAL_PORT=18443
# VM 侧远端目标端口（= WINVM_SERVICE_PORT）
WINVM_TUNNEL_REMOTE_PORT=18443
# 隧道后端：鸿蒙宿主（process.platform 为 ohos 或 openharmony——实机 HMOS 报 openharmony）
# 自动用进程内 ssh2（oh-tunnel.mjs，不依赖系统 ssh）；也可显式写 ssh2 强制启用（双保险建议）。
# win32 宿主留空则走系统 ssh 子进程。
# 出处：delivery/setup.mjs TUNNEL 阶段守卫（ohos/openharmony 双兼容，QA E-4 实证）+ docs/oh-host-install-run-test.md §0
WINVM_TUNNEL_BACKEND=ssh2

# ---------- 执行模式（安全红线，默认勿改）----------
# 真执行的唯一入口是显式 --apply：不传 --apply 永远 dry-run，不改动任何系统。
# WINVM_DRY_RUN=1 是兜底保险：即便传了 --apply 也强制保持 dry-run。
# （配置里写 WINVM_DRY_RUN=0 也不会自动触发执行 —— 出处 delivery/setup.mjs 头注。）
WINVM_DRY_RUN=1

# ---------- CL-018 增量配置（全部可选，缺省即出厂默认）----------
# C1 · codebuddy 常驻会话（根治 A2A 委派停滞）
#   1=启用常驻会话（默认）；0=强制走单次 -p（排障/回滚用）。
#   常驻不可用时**自动降级**为单次 -p，语义不变（AC1.5）。
WINVM_LLM_PERSISTENT=1
#   固定会话标识（AC1.4：多次委派复用同一 session；跨任务命中缓存，延迟骤降）
WINVM_LLM_SESSION_ID=winvm-persistent
#   空闲 TTL（毫秒）：到期释放常驻子进程，下次委派重建；默认 300000
WINVM_LLM_SESSION_IDLE_MS=300000
#   就绪等待上限（毫秒）：等待首个 system/init；默认 180000（D-5 演进：与 warmup 对齐，
#   覆盖 codebuddy 进程级冷启动实测 49.3–107s；示例值=缺省值）
WINVM_LLM_SESSION_READY_MS=180000
#   累计重建上限：超限置 disabled（此后恒定回退单次 -p）；默认 5
WINVM_LLM_SESSION_MAX_RESTARTS=5
#   常驻子进程工作集上限（字节）：超限回收重建；默认 536870912（512MB）
WINVM_LLM_SESSION_MAX_WS_BYTES=536870912

# C2 · A2A 委派超时（优先级：CLI --timeout > 本 env > 默认 600000）
#   注意：默认 600000ms 已 ≥150s，**不得回退**；本 env 仅用于按环境微调。
WINVM_A2A_TIMEOUT_MS=600000

# C3 · 服务日志落盘（轮转 + 保留策略；目录不可写时降级但**服务仍启动**）
#   日志目录（支持 %LOCALAPPDATA% 等 %ENV% 占位符）；默认 %LOCALAPPDATA%/WinVMBridge/logs
WINVM_LOG_DIR=%LOCALAPPDATA%/WinVMBridge/logs
#   日志级别：debug|info|warn|error|silent；默认 info
WINVM_LOG_LEVEL=info
#   单文件上限（字节）：超限即轮转；默认 10485760（10MB）
WINVM_LOG_MAX_BYTES=10485760
#   最多保留文件数：超限删最旧；默认 7
WINVM_LOG_MAX_FILES=7
#   最多保留天数：超限删最旧；默认 14
WINVM_LOG_MAX_DAYS=14

# C5 · system.network.config 进程内缓存
#   缓存 TTL（毫秒）：默认 45000；`refresh:true` 参数可绕过。服务启动时异步预热。
WINVM_NETCFG_TTL_MS=45000

# C4 · appops 窗口/进程过滤名单（追加到默认名单；逗号/分号分隔）
#   注意：默认规则**不会**整体排除 ApplicationFrameHost（它承载真实 UWP 应用，
#         如「设置」）；仅排除「无生产性内容」的窗口。如需追加自定义名单：
WINVM_APPOPS_EXCLUDE_PROCS=
WINVM_APPOPS_EXCLUDE_TITLE_PATTERNS=

# ---------- 可选进阶项（默认留空即可）----------
# SSH 私钥路径。留空时 setup.mjs TUNNEL 相位（ssh2 后端）会自动按默认链探测：
#   ~/.ssh/id_ed25519 → ~/.ssh/id_ecdsa → ~/.ssh/id_rsa（命中即用，日志会打印来源）。
# 仅私钥在非默认路径时才需填写（进程内 ssh2 无法复用系统 ssh agent，必须有真实私钥文件）。
WINVM_VM_KEY=
# SSH 密码（不推荐；公钥免密未配好时的临时兜底，仅 ssh2 隧道后端支持）
WINVM_VM_PASSWORD=

# ============================================================================
# CL-018 增量配置（全部可选；不设置即用内置默认，出厂行为不变）
# ----------------------------------------------------------------------------
# 读取方：vm-service（C1/C3/C5）、psmod（C4/C5，PowerShell 侧读同名 env）、
#         host-a2a-bridge / install-host.mjs（C2）。
# 优先级：CLI 参数 > 环境变量 > 内置默认。默认值即验收基线，**不得回退**。
# ============================================================================

# ---------- C1 · codebuddy 常驻会话（根治 A2A 委派停滞）----------
# 是否启用常驻会话（1=启用，默认；0=强制走单次 -p 冷启动，用于排障/回滚）
WINVM_LLM_PERSISTENT=1
# 固定会话标识（多次委派复用同一 session；仅标识用途，非密钥）
WINVM_LLM_SESSION_ID=winvm-persistent
# 空闲 TTL（毫秒）：到期释放常驻子进程，下次委派重建。默认 300000（5 分钟）
WINVM_LLM_SESSION_IDLE_MS=300000
# 就绪（首个 system/init）等待上限（毫秒）。默认 180000 —— D-5（2026-10-17）演进后与
# warmup 对齐：codebuddy 进程级冷启动实测 49.3–107s，原 60s 阈值本身已被实测越过，
# 会把正常慢启动误判为不可用并降级到「又一次全额冷启动」（权威缺省=core/constants LLM_SESSION_READY_MS_DEFAULT）。
WINVM_LLM_SESSION_READY_MS=180000
# 累计重建上限：超限置 disabled，此后恒定回退单次 -p（不再尝试常驻）。默认 5
WINVM_LLM_SESSION_MAX_RESTARTS=5
# 常驻子进程工作集上限（字节）：超限回收重建。默认 536870912（512MB）
# 说明：Node 无法直接读子进程 ws，生产环境该护栏仅在注入了 ws 探针时生效；
#       常规保护由「空闲 TTL + 重建上限」承担。
WINVM_LLM_SESSION_MAX_WS_BYTES=536870912

# ---------- C2 · A2A 委派超时（缓解，非修复）----------
# 宿主对 VM 的 A2A 委派等待上限（毫秒）。出厂默认 600000（≥150s）**不得回退**；
# 优先级：--timeout（CLI） > WINVM_A2A_TIMEOUT_MS > 默认 600000。
# 本项为**缓解**手段（降低失败率），不承诺消除 A2A_DELEGATE_FAILED（那由 C1 常驻会话负责）；
# 超时可能处于正常冷启动窗口（首轮冷启动可达 75–107s），并非环境故障。
WINVM_A2A_TIMEOUT_MS=600000

# ---------- C3 · 服务日志落盘 ----------
# 日志目录。默认 %LOCALAPPDATA%\WinVMBridge\logs（服务以交互用户运行）
WINVM_LOG_DIR=
# 日志级别：debug / info / warn / error（默认 info）
WINVM_LOG_LEVEL=info
# 单文件上限（字节）：超限轮转。默认 10485760（10MB）
WINVM_LOG_MAX_BYTES=10485760
# 最多保留文件数（超限删最旧）。默认 7
WINVM_LOG_MAX_FILES=7
# 最多保留天数（超限删最旧）。默认 14
WINVM_LOG_MAX_DAYS=14
# 注：日志目录不可写时**服务仍能启动**（降级为控制台/静默），
#     /health 的 logging.degraded=true 暴露该事实；日志内 token/bearer 等敏感串恒为 0 命中。

# ---------- K4/P3 · A2A 审批等待 TTL（vm-service 读取）----------
# A2A 委派命中宿主审批闸后，任务挂起为 input-required 等待宿主人工应答的**最长时长**（毫秒）。
# 默认 1800000（30 分钟）。超时按「拒绝」收口：挂起 Promise resolve(false)（桥保持 K3
# 旧行为 ok=false，绝不自批）、任务转 failed（原因 approval timeout）、清理宿主侧续跑令牌。
# 非法值回退默认。设得过长会让宿主断连的任务长期占位；过短会误伤正常人工审批窗口。
WINVM_APPROVAL_TTL_MS=1800000

# ---------- C4 · appops.state.query 过滤名单（psmod 读取）----------
# 追加到默认进程名黑名单（逗号/分号分隔）。默认名单已含 ShellExperienceHost /
# RuntimeBroker / TextInputHost / NotifyHelper / appstore 等；**默认不含 ApplicationFrameHost**
# （它承载真实 UWP 应用，按标题内容判定而非按进程名一刀切）。
WINVM_APPOPS_EXCLUDE_PROCS=
# 追加到默认窗口标题正则名单（逗号/分号分隔）。默认已含 空标题 / shellmsggetmessagewindow /
# installer / setup / 安装程序 / 卸载 等
WINVM_APPOPS_EXCLUDE_TITLE_PATTERNS=

# ---------- C5 · system.network.config 进程内缓存（psmod 读取）----------
# 缓存 TTL（毫秒）。默认 45000；入参 refresh:true 可绕过缓存强制重采。
# 冷启动达标靠 vm-service 启动后的**异步预热**（预热后首调命中缓存 <3s）。
WINVM_NETCFG_TTL_MS=45000

