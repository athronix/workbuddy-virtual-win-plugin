# ============================================================
# WinVM Bridge 双端一键部署配置（复制为 .env 后填写）
# 说明：所有配置集中于此文件；delivery/setup.mjs 读取本文件完成
#       宿主机侧 + VM 侧 的 安装 / 部署 / 隧道 / 自检。
# 安全：.env 含连接凭据，请勿提交入库（已加入 .gitignore）。
# ============================================================

# ---------- 通用 ----------
# VM 服务监听端口（回环 127.0.0.1，VM 零对外暴露）
WINVM_SERVICE_PORT=18443

# ---------- 宿主机侧（install-host.mjs 读取）----------
# 是否部署宿主机侧插件（1=是）
HOST_DEPLOY=1
# WorkBuddy 主目录（留空则脚本自动探测 ~/.workbuddy）
HOST_WORKBUDDY_HOME=
# 部署归属用户（仅用于日志/路径提示）
HOST_INSTALL_USER=vmadmin

# ---------- VM 侧（install-vm.mjs 读取）----------
# 是否部署 VM 侧（1=是）
VM_DEPLOY=1
# VM 地址与 SSH（用于远程 scp / ssh 开隧道；留空则视为"本地手动部署"）
# 认证：仅支持 SSH 公钥，.env 无密码字段；请将宿主 ~/.ssh/id_ed25519.pub
#       追加进远端 %USERPROFILE%\.ssh\authorized_keys 并修 ACL（详见 DEPLOYMENT.md §7 / SECURITY-GOVERNANCE §6）。
#       非回环直连才需 WINVM_BEARER_TOKEN（默认走隧道免校验，绝大多数场景无需配置）。
VM_HOST=192.168.1.50
VM_SSH_PORT=22
VM_USER=vmadmin
# VM 内部部署根目录
VM_DEPLOY_DIR=C:/WinVMBridge
# VM 侧选用哪个 AI Agent（agent.provider）：
#   workbuddy-deterministic  = 确定性执行器（默认，可预测、易监管）
#   workbuddy                = LLM Agent（VM 内 codebuddy CLI，承接开放/创意任务）
WINVM_VM_PROVIDER=workbuddy-deterministic
# LLM 运行时可执行名（仅 WINVM_VM_PROVIDER=workbuddy 时生效）
WINVM_WORKBUDDY_CLI=codebuddy

# ---------- SSH 隧道（宿主 ↔ VM，仅经 127.0.0.1）----------
# 是否建立 SSH 本地端口转发（1=是）
WINVM_SETUP_TUNNEL=1
WINVM_TUNNEL_LOCAL_PORT=18443
WINVM_TUNNEL_REMOTE_PORT=18443

# ---------- 执行模式 ----------
# 真执行的**唯一**入口是显式 --apply：不传 --apply 永远只规划、不改动任何系统。
#   （配置里写 WINVM_DRY_RUN=0 也不会自动触发执行 —— 早期版本此处有 footgun，
#    WINVM_DRY_RUN=0 时不带 --apply 也会真执行，直接跑脚本会误伤真机。）
# WINVM_DRY_RUN=1 是兜底保险：即便传了 --apply 也强制保持 dry-run。
WINVM_DRY_RUN=1
