# WinVM Bridge 部署配置（.env 模板 · 复制为 <包根>/.env 后核对）
# 安全红线：真执行入口=setup.mjs --apply；本文件里 WINVM_DRY_RUN=1 时连 --apply 也强制 dry-run。
# 密码纪律：WINVM_VM_PASSWORD 只在【运行期环境变量】注入（V1.4.20 起 setup 会把本文件的值回注
# process.env——历史版本只读 process.env，造成“.env 填了密码隧道仍失败”的 X-6 陷阱）；
# 交付/归档前删除本键行。

WINVM_SERVICE_PORT=18443
HOST_DEPLOY=1
HOST_WORKBUDDY_HOME=
HOST_INSTALL_USER=

VM_DEPLOY=1
VM_HOST=
VM_SSH_PORT=22
VM_USER=
VM_DEPLOY_DIR=C:/WinVMBridge

# provider：workbuddy-deterministic=确定性执行器（默认；无需 codebuddy 交互登录，CLI 缺失仅 WARNING）
#            workbuddy=LLM 常驻会话（需 VM 内 codebuddy 登录=DB-4 结构性人工项）
#            hermes-agent=MCP 预注册
WINVM_VM_PROVIDER=workbuddy-deterministic
WINVM_WORKBUDDY_CLI=codebuddy

WINVM_SETUP_TUNNEL=1
WINVM_TUNNEL_LOCAL_PORT=18443
WINVM_TUNNEL_REMOTE_PORT=18443
WINVM_TUNNEL_BACKEND=ssh2

WINVM_DRY_RUN=0
# WINVM_VM_PASSWORD=            # 仅密码通道需要；建议部署后清除
# WINVM_VM_KEY=/path/to/id_ed25519  # 隧道私钥显式路径（缺省自动探测 ~/.ssh/id_ed25519）
