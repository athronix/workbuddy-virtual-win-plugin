# 依赖与构建产物
node_modules/
**/dist/
**/*.tsbuildinfo

# 发布包（可重建产物：由 delivery/pack-release.mjs 生成，逐文件指纹与构建证据入 qa/release/）
release/

# 运行时 / 生成物
# 注意：`.workbuddy/` 整目录随仓库同步（含迁移交接档案 handover/ 与每日工作记忆 memory/），
#       不进 .gitignore。其中的 `.env` 类敏感文件本就不在该目录内（见下方 .env 规则）。
delivery/.generated/
# winvm-plugin 管理 CLI 启动器（部署时由 deploy-winvm-plugin.mjs 生成，非源码）
delivery/winvm-plugin
delivery/winvm-plugin.cmd
delivery/.winvm-context.json

# 本地配置（含连接凭据，禁止入库）
.env
.env.local

# 日志
*.log

# OS / 编辑器
.DS_Store
Thumbs.db

# 中间/测试/探测产物（原始证据与归档，不入库）
qa/evidence/
qa/archive/

# Windows 变量展开失败产生的垃圾目录（字面量 %LOCALAPPDATA%）
%LOCALAPPDATA%/
# 同上同类缺陷：VM 侧安装器在鸿蒙宿主裸跑时盘符路径被按相对路径物化（R18-A §3，证据目录保留不删）
C:/

# 本地部署环境文件（VM 主机/用户等连接配置，禁止入库；模板见 delivery/env.example）
.env.deploy*

# 会话临时诊断脚本
.workbuddy/tmp/

# 测试运行产生的临时 fixture（mkdtempSync 随机后缀，非静态资产）
tests/fixtures/cl018-config/cfg-*/
tests/fixtures/cl018-logs/log-*/

# 会话/自动化卫生项（批6 P2 族清扫 2026-10-14，用户授权）：
# commit_msg 草稿（多轮主理人提交中间产物）与 v3-kn2 探针 req/resp/meta
# 都是可再生的会话产物，长期挂 untracked 会污染 git status 判据面
.workbuddy/commit_msg*.txt
v3-kn2.meta.json
v3-kn2.req.json
v3-kn2.resp.json
